+++ b/pysisyphus/irc/IRC.py
@@ -59,6 +59,7 @@
         dump_fn="irc_data.h5",
         dump_every=5,
         stop_func=None,
+        stop_on_energy_increase=True,
     ):
         """Base class for IRC calculations.
 
