# Python
.venv/
__pycache__/
*.pyc

# Large ORCA binaries and scratch: archived to Zenodo, not committed
*.gbw
*.densities
*.densitiesinfo
*.tmp
*.tmp.*
*.cube
*.cub
*.loc
*.bibtex
*_property.txt
*.engrad
*.opt
*.cpcm
*.cpcm_corr
*.smd.out
*.uco
*.ges

# Per-frame orbital cubes and raw frame outputs (hundreds of MB): Zenodo
reactions/*/03_orbitals/cubes/
reactions/*/03_orbitals/frames/
reactions/*/05_render/png*/

# Console captures
console_*.txt

# Render scratch: test frames and Blender logs
reactions/*/05_render/preview*
reactions/*/05_render/*.log

# ORCA scratch left by stopped or still-running jobs
*.bas[0-9]
*.hostnames
*.carthess
*.lastscf
*.lastint
*.lastgrad
*.scfgrad.inp
*.loc.inp
*.[0-9][0-9][0-9].hess
*.smd.grd
*.hostnames.sav

# Publication-figure panel renders (regenerated by the figure step)
reactions/*/05_render/figure/

# Live core-ledger state (the log, allocation.log, is kept)
docs/level_test_queue/allocation.json
docs/level_test_queue/allocation.lock
docs/level_test_queue/allocation.tmp
